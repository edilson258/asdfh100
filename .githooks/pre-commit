#!/usr/bin/env bash
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged_files" ]; then
  exit 0
fi

matches=()
while IFS= read -r file; do
  [ -z "$file" ] && continue
  [ ! -f "$file" ] && continue

  case "$file" in
    .gitignore|.githooks/*|.env|.env.*|*.pem|*.key|*.crt|*.csr|*.p12|*.pfx|*.jks|*.keystore|*.secret|*.token|*service-account*.json|*firebase*.json|*gcloud*.json|*credentials*.json|*secrets*.json|*.bak|*.old)
      continue
      ;;
  esac

  if grep -Eiq 'AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|xox[baprs]-[0-9A-Za-z-]+|-----BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----|client_secret|clientSecret|api[_-]?key|secret[_-]?key|password\s*[:=]|token\s*[:=]' "$file"; then
    matches+=("$file")
  fi
done <<< "$staged_files"

if [ "${#matches[@]}" -gt 0 ]; then
  echo " ERROR: Commit blocked. Secret-like content detected in staged files:" >&2
  printf '  - %s\n' "${matches[@]}" >&2
  echo >&2
  echo "Remove the secret, move it to a local-only file, or use a safe example file such as .env.example." >&2
  exit 1
fi

exit 0
